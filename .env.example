# Server
GEMINI_API_KEY=""

# Client
# Set true only for local/demo UI. Production should be false.
VITE_DEMO_MODE="false"
VITE_API_BASE_URL=""

# Optional broker/data adapter configuration.
MARKET_DATA_BASE_URL=""
MARKET_DATA_TOKEN=""

# Daily price history for the screener and backtest comes from your 5paisa sign-in by default.
# Set MARKET_DATA_PROVIDER=xts to use the XTS adapter below instead.
MARKET_DATA_PROVIDER="5paisa"
SCREENER_SYMBOLS=""
# true = use the complete NSE+BSE cash + MCX derivatives universe from the 5Paisa scrip master; false = use SCREENER_SYMBOLS
AUTO_UNIVERSE="true"
# Stocks the screener reads. Leave blank for the Nifty 100, or list your own: SCREENER_SYMBOLS="NSE:INFY,NSE:TCS".
# SCREENER_FULL_MARKET="true" reads every listed stock (thousands of requests, very slow).
SCREENER_FULL_MARKET="false"
# false = lazy-load daily history on first tick; true = preload all histories at startup (resource intensive)
MINERVINI_PRELOAD_HISTORY="false"
RS_BENCHMARK_SYMBOL="NIFTY 50"

# XTS adapter
XTS_MARKET_DATA_BASE_URL=""
XTS_ACCESS_TOKEN=""
XTS_QUOTE_PATH="/instruments/quotes"
XTS_HISTORY_PATH="/instruments/candles"

# Production database
DATABASE_URL="postgresql://user:password@localhost:5432/minervini"
DATABASE_SSL="false"

# 5paisa Xstream real-time market feed
REALTIME_MARKET_PROVIDER="5paisa"
FIVEPAISA_ACCESS_TOKEN=""
FIVEPAISA_CLIENT_CODE=""
FIVEPAISA_WEBSOCKET_URL="wss://openfeed.5paisa.com/feeds/api/chat"
FIVEPAISA_RECONNECT_MS="3000"
# WebSocket sharding: 5Paisa currently advertises 200 websocket subscriptions; keep headroom per shard.
FIVEPAISA_WS_SHARD_SIZE="180"
# Number of simultaneous market-feed websocket connections allowed by this app. Increase only if your account/provider permits it.
FIVEPAISA_WS_MAX_CONNECTIONS="4"
# Keep priority symbols live when the universe is larger than connection capacity.
FIVEPAISA_PRIORITY_SYMBOLS="NSE:NIFTY 50,NSE:BANKNIFTY"
# Rotate secondary shards so the full universe receives periodic live coverage.
FIVEPAISA_WS_ROTATION_MS="60000"
FIVEPAISA_WS_CONNECTION_STAGGER_MS="350"
# Adaptive Minervini priority: promote high-conviction setups into the permanent live tier.
FIVEPAISA_ADAPTIVE_PRIORITY_ENABLED="true"
FIVEPAISA_ADAPTIVE_PRIORITY_MAX="180"
FIVEPAISA_ADAPTIVE_PROMOTE_SCORE="70"
FIVEPAISA_ADAPTIVE_DEMOTE_SCORE="55"
FIVEPAISA_ADAPTIVE_REBALANCE_MS="15000"
FIVEPAISA_SCRIP_MASTER_URL="https://openapi.5paisa.com/VendorsAPI/Service1.svc/ScripMaster/segment/All"
FIVEPAISA_SCRIP_MASTER_FILE="data/5paisa-scrip-master.json"
FIVEPAISA_SCRIP_MASTER_REFRESH_HOURS="24"
# Example: [{"exchange":"NSE","exchangeType":"C","scripCode":2885,"symbol":"RELIANCE"},{"exchange":"BSE","exchangeType":"C","scripCode":500325,"symbol":"RELIANCE"}]
FIVEPAISA_INSTRUMENTS_JSON='[]'

# 5paisa OAuth/token automation
FIVEPAISA_APP_KEY=""
FIVEPAISA_ENCRYPTION_KEY=""
FIVEPAISA_USER_ID=""
FIVEPAISA_VENDOR_KEY=""
FIVEPAISA_OAUTH_CALLBACK_URL="http://localhost:3000/api/5paisa/auth/callback"
FIVEPAISA_TOKEN_FILE="data/5paisa-token.json"

# Lightweight full-universe pre-filter before expensive Minervini analysis
MIN_UNIVERSE_PRICE="20"
MIN_UNIVERSE_MIN_LIQUIDITY="1000000"
# MCX automatic universe (5Paisa Exch=M, ExchType=D). Minervini is applied to daily contract history.
MCX_AUTO_UNIVERSE="true"

# Obsidian vault folder. Notes go to <vault>/Trading/{Plans,Daily,Backtests}. Leave blank to turn off.
OBSIDIAN_VAULT_PATH=

# Telegram trade alerts (new picks, manual sends, stop/target hits).
# Use a SEPARATE bot from any bot you use to chat with Claude via Telegram —
# create it with @BotFather, then message it once and read your chat id from
# GET https://api.telegram.org/bot<token>/getUpdates (or GET /api/telegram/chat-id-hint
# on this app once the token below is set). Leave blank to disable.
TELEGRAM_ALERTS_BOT_TOKEN=""
TELEGRAM_ALERTS_CHAT_ID=""
