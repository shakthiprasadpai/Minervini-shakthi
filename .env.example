# Server
GEMINI_API_KEY=""

# Client
# Set true only for local/demo UI. Production should be false.
VITE_DEMO_MODE="false"
VITE_API_BASE_URL=""

# Optional broker/data adapter configuration.
MARKET_DATA_BASE_URL=""
MARKET_DATA_TOKEN=""

# Market data: choose bigul or xts
MARKET_DATA_PROVIDER="bigul"
SCREENER_SYMBOLS=""
# true = use the complete NSE+BSE cash universe from the 5Paisa scrip master; false = use SCREENER_SYMBOLS
AUTO_UNIVERSE="true"
# false = lazy-load daily history on first tick; true = preload all histories at startup (resource intensive)
MINERVINI_PRELOAD_HISTORY="false"
RS_BENCHMARK_SYMBOL="NIFTY 50"

# Bigul adapter
BIGUL_API_BASE_URL=""
BIGUL_API_TOKEN=""
BIGUL_QUOTE_PATH="/market/quote"
BIGUL_HISTORY_PATH="/market/history"

# XTS adapter
XTS_MARKET_DATA_BASE_URL=""
XTS_ACCESS_TOKEN=""
XTS_QUOTE_PATH="/instruments/quotes"
XTS_HISTORY_PATH="/instruments/candles"

# Production database
DATABASE_URL="postgresql://user:password@localhost:5432/minervini"
DATABASE_SSL="false"

# 5paisa Xstream real-time market feed
REALTIME_MARKET_PROVIDER="5paisa"
FIVEPAISA_ACCESS_TOKEN=""
FIVEPAISA_CLIENT_CODE=""
FIVEPAISA_WEBSOCKET_URL="wss://openfeed.5paisa.com/feeds/api/chat"
FIVEPAISA_RECONNECT_MS="3000"
FIVEPAISA_SCRIP_MASTER_URL="https://openapi.5paisa.com/VendorsAPI/Service1.svc/ScripMaster/segment/All"
FIVEPAISA_SCRIP_MASTER_FILE="data/5paisa-scrip-master.json"
FIVEPAISA_SCRIP_MASTER_REFRESH_HOURS="24"
# Example: [{"exchange":"NSE","exchangeType":"C","scripCode":2885,"symbol":"RELIANCE"},{"exchange":"BSE","exchangeType":"C","scripCode":500325,"symbol":"RELIANCE"}]
FIVEPAISA_INSTRUMENTS_JSON='[]'

# 5paisa OAuth/token automation
FIVEPAISA_APP_KEY=""
FIVEPAISA_ENCRYPTION_KEY=""
FIVEPAISA_USER_ID=""
FIVEPAISA_VENDOR_KEY=""
FIVEPAISA_OAUTH_CALLBACK_URL="http://localhost:3000/api/5paisa/auth/callback"
FIVEPAISA_TOKEN_FILE="data/5paisa-token.json"
